@page
@model DemoASPApp.Pages.UserDataModel
@using UserManagement.User;
@{
    Layout = "_MyLayout";
}
<ul>
    <li><strong>User ID:</strong> @Model.user.userID</li>
    <li><strong>Name:</strong> @Model.user.userName</li>
    <li><strong>Father Name:</strong> @Model.user.fatherName</li>
    <li><strong>Mother Name:</strong> @Model.user.motherName</li>
    <li><strong>Aadhaar Number:</strong> @Model.user.AadhaarNumber</li>
    <li><strong>Email:</strong> @Model.user.email</li>
    @if (Model.user?.phone != null && Model.user.phone.Count >= 2)
    {
        <ul>
            <li><strong>Primary Phone:</strong> @Model.user.phone[0].phoneNumber</li>
            <li><strong>Secondary Phone:</strong> @Model.user.phone[1].phoneNumber</li>
        </ul>
    }
    else if (Model.user?.phone != null && Model.user.phone.Count == 1)
    {
        <ul>
            <li><strong>Primary Phone No:</strong> @Model.user.phone[0].phoneNumber</li>
            <li><strong>Secondary Phone No:</strong> Not available</li>
        </ul>
    }
    else
    {
        <p>No phone numbers available.</p>
    }


    <li><strong>PAN:</strong> @Model.user.panCardNo</li>
    <li><strong>Passport:</strong> @Model.user.passportNo</li>
  
</ul>

<li class="nav-item" style="list-style:none">
    <a href="/Address?id=@Model.user.userID" class="btn btn-primary">View Address</a>
    <a href="/Index1" class="btn btn-primary">Back to View</a>

</li>