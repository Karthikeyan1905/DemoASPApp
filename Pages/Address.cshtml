@page
@model DemoASPApp.Pages.UserAddressModel
@using UserManagement.Model.User

@{
    Layout = "_MyLayout";
}

<h2>User Address Details</h2>

@if (Model.addresses != null && Model.addresses.Count > 0)
{
    @foreach (var address in Model.addresses)
    {
        <div class="company-card">
            <h5>@address.addressType Address</h5>
            <ul>
                <li><strong>Door No:</strong> @address.permDoorNo</li>
                <li><strong>Street:</strong> @address.street</li>
                <li><strong>Town:</strong> @address.town</li>
                <li><strong>District:</strong> @address.district</li>
                <li><strong>State:</strong> @address.state</li>
                <li><strong>Country:</strong> @address.country</li>
                <li><strong>Pincode:</strong> @address.pincode</li>
            </ul>
        </div>
    }

    <li class="nav-item" style="list-style:none">
        <a class="btn btn-primary" href="/UserData?id=@Request.Query["id"]">User Info</a>
        <a class="btn btn-primary" href="/ExperianceData?id=@Request.Query["id"]">Experience</a>
    </li>
}
else
{
    <p>No address information available for this user.</p>
}