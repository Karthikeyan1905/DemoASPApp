@page
@model DemoASPApp.Pages.EmployeeModel
@{
    Layout = "_MyLayout";
}

<h2>Employee Directory</h2>

@if (Model.EmployeeList != null && Model.EmployeeList.Any())
{
    <div class="row">
        @foreach (var emp in Model.EmployeeList)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Employee ID: @emp.employeeID</h5>
                        <p><strong>Name:</strong> @emp.user?.userName</p>
                        <p><strong>Department:</strong> @emp.department?.deptName</p>
                        <p><strong>Designation:</strong> @emp.designation?.designationName</p>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <p class="text-muted">No employees found.</p>
}