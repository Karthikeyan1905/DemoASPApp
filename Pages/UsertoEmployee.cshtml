@page
@model DemoASPApp.Pages.UsertoEmployeeModel
@{
    Layout = "_MyLayout";
}

<h2>Promote User to Employee</h2>

@if (Model.user != null)
{
    <p><strong>User ID:</strong> @Model.user.userID</p>
    <p><strong>Name:</strong> @Model.user.userName</p>

    <form method="post">
        <input type="hidden" name="userID" value="@Model.user.userID" />

        <label for="department">Department:</label>
        <select name="departmentID" required>
            @foreach (var dept in Model.DepartmentList)
            {
                <option value="@dept.deptID">@dept.deptName</option>
            }
        </select>
        <br />
        <label for="designation">Designation:</label>
        <select name="designationID" required>
            @foreach (var desig in Model.DesignationList)
            {
                <option value="@desig.designationID">@desig.designationName</option>
            }
        </select>
        <br />
        <label for="team">Team:</label>
        <select name="teamID" required>
            @foreach (var team in Model.TeamList)
            {
                <option value="@team.teamID">@team.teamName</option>
            }
        </select>
        <br />
        <button type="submit">Promote to Employee</button>
    </form>

}
else
{
    <p class="text-danger">User not found.</p>
}
