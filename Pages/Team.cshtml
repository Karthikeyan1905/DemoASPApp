@page
@model DemoASPApp.Pages.TeamModel
@{
    Layout = "_MyLayout";
}

<h1>Team</h1>

@if (Model.user != null && Model.team != null)
{
    <div class="border rounded p-3 shadow-sm">
        <p><strong>User ID:</strong> @Model.user.userID</p>
        <p><strong>User Name:</strong> @Model.user.userName</p>
        <p><strong>Team ID:</strong> @Model.team.teamID</p>
        <p><strong>Team Name:</strong> @Model.team.teamName</p>
    </div>
}
else
{
    <p class="text-muted">No team information available for this user.</p>
}
